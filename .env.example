# Copy to .env for local use. In production these come from a secret manager (see docs/security.md) — never commit real values.
NODE_ENV=development
PORT=3000
METRICS_PORT=9464
WORKER_METRICS_PORT=9465
LOG_LEVEL=info
TRUST_PROXY=false

DATABASE_URL=postgres://amrutam:amrutam@localhost:5432/amrutam
DATABASE_SSL=false
DB_POOL_MAX=20
# Optional. Enables shared cache + shared rate-limit counters across replicas.
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-0123
# During a JWT secret rotation: put the old value here for one access-token lifetime, then remove it.
# JWT_SECRET_PREVIOUS=
JWT_ISSUER=amrutam
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Versioned keyrings "<version>:<base64 32 bytes>[,<version>:<…>]"; highest version encrypts, all decrypt.
# openssl rand -base64 32
DATA_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
AUDIT_HMAC_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_PROVIDER=mock

PASSWORD_SCRYPT_N=32768
SLOT_HOLD_MINUTES=10
FREE_CANCELLATION_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=10
WORKER_CONCURRENCY=5
WORKER_POLL_MS=1000
